# Grocy Instance Configuration
GROCY_URL=http://localhost:9283
GROCY_API_KEY=your_grocy_api_key_here

# Grocy MCP Transport Configuration ('stdio' or 'http')
GROCY_MCP_TRANSPORT=stdio
# GROCY_MCP_HTTP_URL=http://localhost:8000/mcp

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RPM=15
GEMINI_MIN_INTERVAL=2

# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Google Calendar & Scheduling (Optional / Milestone 5)
GOOGLE_CALENDAR_CREDENTIALS_PATH=credentials.json
GOOGLE_CALENDAR_ID=your_email@gmail.com
TIMEZONE=America/New_York


